# Copy beside your config.toml as .env. auto prefers a configured API key.
SSP_AUTHORIZATION=
# https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=
# https://app.tavily.com/home
TAVILY_API_KEY=
# https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
# https://platform.parallel.ai/settings?tab=api-keys
# Parallel balance collection uses CLI OAuth; standard API keys are unsupported.
# MiniMax China Token Plan key (not a pay-as-you-go key).
MINIMAX_API_KEY=
